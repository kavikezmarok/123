<Window x:Class="LetenkyMonitor.FlightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Let"
        Width="470"
        Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Názov letu"/>
                <TextBox x:Name="NameBox"/>

                <TextBlock Text="Odletové letisko (napr. KRK)"/>
                <TextBox x:Name="OriginBox"/>

                <TextBlock Text="Cieľové letisko (napr. VLC)"/>
                <TextBox x:Name="DestinationBox"/>

                <TextBlock Text="Dátum odletu (RRRR-MM-DD)"/>
                <TextBox x:Name="DepartureBox"/>

                <TextBlock Text="Dátum návratu (RRRR-MM-DD)"/>
                <TextBox x:Name="ReturnBox"/>

                <TextBlock Text="Preferovaná aerolinka"/>
                <TextBox x:Name="AirlineBox"/>

                <TextBlock Text="Počet dospelých"/>
                <TextBox x:Name="AdultsBox"/>

                <TextBlock Text="Kontrola ± dní"/>
                <TextBox x:Name="ToleranceBox"/>

                <CheckBox x:Name="EnabledBox"
                          Content="Sledovanie zapnuté"
                          Margin="4,10"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Zrušiť" IsCancel="True"/>
            <Button Content="Uložiť" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
