<Window x:Class="LetenkyMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nastavenia"
        Width="520"
        Height="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Telegram bot token"/>
            <PasswordBox x:Name="TokenBox"/>

            <TextBlock Text="Telegram Chat ID"/>
            <TextBox x:Name="ChatIdBox"/>

            <TextBlock Text="Ranná kontrola"/>
            <TextBox x:Name="MorningBox"/>

            <TextBlock Text="Večerná kontrola"/>
            <TextBox x:Name="EveningBox"/>

            <CheckBox x:Name="HeadlessBox"
                      Content="Spúšťať prehliadač na pozadí"
                      Margin="4,10"/>

            <Button Content="Otestovať Telegram"
                    HorizontalAlignment="Left"
                    Click="TestTelegram_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Zrušiť" IsCancel="True"/>
            <Button Content="Uložiť" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
